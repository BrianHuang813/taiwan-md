  }
  .last-modified {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
  .modified-date {
    color: #64748b;
  }

  .meta-icon {
    font-size: 1rem;
  }

  .status-tag {
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-chip);
    font-weight: 500;
    font-size: 0.8rem;
    border: 1px solid rgba(148, 163, 184, 0.18);
  }

  .lang-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.95rem;
    background: rgba(255, 255, 255, 0.72);
    border-radius: var(--radius-chip);
    font-size: 0.95rem;
    color: #64748b;
    border: 1px solid rgba(148, 163, 184, 0.18);
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.04);
  }

  /* Content Styling — Taiwan Typography 排版 */
  .content {
    font-family: var(--font-reading);
    font-size: 1.125rem;
    line-height: 2.1;
    color: #333;
    max-width: var(--container-reading);
    margin: 0 auto;
    letter-spacing: 0.01em;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 22px;
    padding: 2.25rem;
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(10px);
    /* 優化中文閱讀 */
    text-align: justify;
    word-break: break-word;
    -webkit-hyphens: auto;
    hyphens: auto;
  }

  /* 標題層級系統 — 清晰的視覺層次 */
  .content h1,
  .content h2,
  .content h3,
  .content h4,
  .content h5,
  .content h6 {
    font-family: var(--font-editorial);
    color: #1a1a1a;
    line-height: 1.4;
    letter-spacing: var(--title-letter-spacing);
  }

  .content > h1:first-child {
    display: none;
  }

  .content h1 {
    font-size: 2rem;
    font-weight: 700;
    margin: 4rem 0 1.5rem 0;
  }

  .content h2 {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 5rem 0 1.75rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--categoryColor);
  }

  .content h3 {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 4rem 0 1.25rem 0;
    color: #1a1a1a;
    padding-left: 0.85rem;
    border-left: 4px solid var(--categoryColor);
  }

  .content h4 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 3rem 0 1rem 0;
    color: #333;
    padding-left: 0.85rem;
    border-left: 3px solid rgba(0, 0, 0, 0.15);
  }

  /* 段落 — 大呼吸感 */
  .content p {
    margin-bottom: 1.75rem;
    line-height: 2.1;
    text-align: justify;
    word-break: break-word;
  }

  /* HR — 報導者風格大間距分隔 */
  .content hr {
    border: none;
    border-top: 1px solid #e0e0e0;
    margin: 3.5rem auto;
    max-width: 120px;
  }

  /* Blockquote — 沈靜引言 */
  .content blockquote {
    border-left: 4px solid var(--categoryColor);
    background: linear-gradient(
      to right,
      var(--categoryColorLight),
      transparent
    );
    padding: 1.5rem 2rem;
    margin: 2.5rem 0;
    font-style: italic;
    color: #555;
    border-radius: 0 8px 8px 0;
    font-size: 1.05rem;
    line-height: 2;
  }

  .content blockquote p {
    margin-bottom: 0.75rem;
  }

  .content blockquote p:last-child {
    margin-bottom: 0;
  }

  /* 列表 — 寬鬆行距，不突出 */
  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.75rem;
  }

  .content :global(ul) {
    list-style: disc;
  }

  .content :global(ol) {
    list-style: decimal;
  }

  .content :global(ul > li),
  .content :global(ol > li) {
    margin-bottom: 0.6rem;
    padding-left: 0.35rem;
    line-height: 1.9;
  }

  .content :global(ul > li::marker) {
    color: var(--categoryColor);
  }

  .content :global(ol > li::marker) {
    color: var(--categoryColor);
    font-weight: 600;
  }

  .content :global(li > p) {
    margin-bottom: 0.75rem;
  }

  .content :global(li > p:last-child) {
    margin-bottom: 0;
  }

  /* 連結 */
  .content a {
    color: var(--categoryColor);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
    font-weight: 500;
    transition: all 0.2s;
  }

  .content a:hover {
    text-decoration-color: transparent;
    background: var(--categoryColorLight);
    border-radius: 2px;
  }

  .content strong {
    font-weight: 700;
    color: #1a1a1a;
  }

  .content em {
    font-style: italic;
  }

  /* 圖片 */
  .content img {
    max-width: 100%;
    max-height: 450px;
    object-fit: cover;
    border-radius: 8px;
    margin: 2.5rem auto;
    display: block;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  /* 圖片載入失敗的優雅降級 */
  .content img.img-broken {
    min-height: 120px;
    max-height: 120px;
    background: #f8f9fa;
    border: 1.5px dashed #d0d5dd;
    box-shadow: none;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    font-size: 0.85rem;
    color: #667085;
    text-align: center;
    padding: 1rem;
    line-height: 1.5;
    word-break: break-word;
    overflow: hidden;
  }

  /* 圖片說明文字 */
  .content p > em:only-child {
    display: block;
    text-align: center;
    font-size: 0.85rem;
    color: #888;
    margin-top: -1.5rem;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  /* 表格 */
  .content :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 2.5rem 0;
    font-size: 0.92rem;
    line-height: 1.7;
    border: 1.5px solid #c5ccd6;
    border-radius: 8px;
    overflow: hidden;
  }
  .content :global(th),
  .content :global(td) {
    padding: 0.9rem 1.15rem;
    border-bottom: 1px solid #d5dbe3;
    border-right: 1px solid #e8ecf0;
    text-align: left;
  }
  .content :global(th:last-child),
  .content :global(td:last-child) {
    border-right: none;
  }
  .content :global(tr:last-child td) {
    border-bottom: none;
  }
  .content :global(th) {
    background: #f0f3f6;
    font-weight: 700;
    color: #1a1a1a;
    border-bottom: 2px solid #c5ccd6;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }
  .content :global(tbody tr:hover) {
    background: rgba(74, 124, 89, 0.04);
  }
  .content :global(tbody tr:nth-child(even)) {
    background: #fafbfc;
  }
  .content :global(tbody tr:nth-child(even):hover) {
    background: rgba(74, 124, 89, 0.06);
  }

  /* Code inline */
  .content code {
    background: #f5f5f5;
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
    color: #c7254e;
  }

  /* Pre code block */
  .content pre {
    background: #f8f9fa;
    padding: 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid #e9ecef;
    line-height: 1.6;
  }

  .content pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  /* ===== NEW ENHANCED MARKDOWN STYLES ===== */

  /* 1. GitHub-style Callouts */
  .content blockquote[data-callout="note"] {
    border-left-color: #3b82f6;
    background: linear-gradient(to right, rgba(59, 130, 246, 0.1), transparent);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.1);
  }

  .content blockquote[data-callout="warning"] {
    border-left-color: #f59e0b;
    background: linear-gradient(to right, rgba(245, 158, 11, 0.1), transparent);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.1);
  }

  .content blockquote[data-callout="tip"] {
    border-left-color: #10b981;
    background: linear-gradient(to right, rgba(16, 185, 129, 0.1), transparent);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.1);
  }

  .content blockquote[data-callout="data"] {
    border-left-color: #8b5cf6;
    background: linear-gradient(to right, rgba(139, 92, 246, 0.1), transparent);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(139, 92, 246, 0.1);
  }

  /* 2. Pull Quote styling */
  .content blockquote[data-callout="pullquote"] {
    border-left: none;
    background: none;
    text-align: center;
    font-size: 1.4em;
    font-weight: 500;
    color: #1a1a1a;
    padding: 3rem 2rem;
    margin: 3rem auto;
    max-width: 600px;
    position: relative;
    font-style: normal;
    line-height: 1.5;
    /* 使用霞鶩文楷加強書法感 */
    font-family: 'LXGW WenKai TC', var(--font-quote);
    letter-spacing: 0.02em;
  }

  .content blockquote[data-callout="pullquote"]::before {
    content: '"';
    font-size: 4rem;
    color: var(--categoryColor);
    position: absolute;
    top: -0.5rem;
    left: 1rem;
    font-family: Georgia, serif;
    line-height: 1;
    opacity: 0.3;
  }

  .content blockquote[data-callout="pullquote"]::after {
    content: '"';
    font-size: 4rem;
    color: var(--categoryColor);
    position: absolute;
    bottom: -1.5rem;
    right: 1rem;
    font-family: Georgia, serif;
    line-height: 1;
    opacity: 0.3;
  }

  .content blockquote[data-callout="pullquote"] strong {
    display: none; /* Hide the ✦ marker */
  }

  /* 3. Timeline styling */
  .content ol[data-timeline="true"] {
    list-style: none;
    padding-left: 0;
    position: relative;
    margin: 3rem 0;
  }

  .content ol[data-timeline="true"]::before {
    content: '';
    position: absolute;
    left: 1.5rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--categoryColor), rgba(0,0,0,0.1));
    border-radius: 1px;
  }

  .content ol[data-timeline="true"] li {
    position: relative;
    padding-left: 4rem;
    margin-bottom: 2rem;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 12px;
    padding: 1.5rem 1.5rem 1.5rem 4rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .content ol[data-timeline="true"] li::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 1.5rem;
    width: 12px;
    height: 12px;
    background: var(--categoryColor);
    border-radius: 50%;
    border: 3px solid white;
    box-shadow: 0 0 0 2px var(--categoryColor);
    z-index: 1;
  }

  .content ol[data-timeline="true"] li strong {
    color: var(--categoryColor);
    font-weight: 700;
    font-size: 1.1em;
  }

  /* 4. Stat Block styling */
  .content table[data-stat="true"] {
    border: none;
    background: none;
    margin: 3rem 0;
    border-radius: 0;
    display: block;
    overflow: visible;
  }

  .content table[data-stat="true"] tbody {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .content table[data-stat="true"] tr {
    display: contents;
  }

  .content table[data-stat="true"] td {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: white;
    border-radius: 16px;
    padding: 2rem 1.5rem;
    border: 2px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .content table[data-stat="true"] td:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .content table[data-stat="true"] tr:first-child td {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--categoryColor);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .content table[data-stat="true"] tr:last-child td {
    font-size: 0.95rem;
    color: #666;
    font-weight: 500;
    line-height: 1.4;
  }

  .content table[data-stat="true"] thead {
    display: none;
  }

  /* 5. Footnotes enhanced styling */
  .content .footnotes-enhanced {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 2px solid #e0e0e0;
    font-size: 0.9rem;
    color: #666;
  }

  .content .footnotes-enhanced::before {
    content: "註釋";
    display: block;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .content .footnote-ref {
    background: var(--categoryColor);
    color: white !important;
    text-decoration: none !important;
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-size: 0.75em;
    font-weight: 600;
    vertical-align: super;
    line-height: 1;
    transition: all 0.2s ease;
  }

  .content .footnote-ref:hover {
    background: #1a1a1a;
    transform: scale(1.05);
  }

  /* 6. Compare Block styling */
  .content table[data-compare="true"] {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    background: none;
    border: none;
    border-radius: 0;
    margin: 3rem 0;
  }

  .content table[data-compare="true"] thead {
    display: contents;
  }

  .content table[data-compare="true"] tbody {
    display: contents;
  }

  .content table[data-compare="true"] tr {
    display: contents;
  }

  .content table[data-compare="true"] th:first-child,
  .content table[data-compare="true"] td:first-child {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(16, 185, 129, 0.05));
    border: 2px solid rgba(16, 185, 129, 0.2);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .content table[data-compare="true"] th:last-child,
  .content table[data-compare="true"] td:last-child {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(239, 68, 68, 0.05));
    border: 2px solid rgba(239, 68, 68, 0.2);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .content table[data-compare="true"] th {
    font-weight: 700;
    text-align: center;
    font-size: 1.1rem;
    border-bottom: none;
    margin-bottom: 1rem;
  }

  .content table[data-compare="true"] th:first-child {
    color: #059669;
  }

  .content table[data-compare="true"] th:last-child {
    color: #dc2626;
  }

  /* 多元觀點 callout (fallback for old blockquotes) */
  .content blockquote:has(strong:first-child):not([data-callout]) {
    border-left-color: #6b7fb5;
    background: linear-gradient(to right, #eef1f7, transparent);
  }

  /* Sources */
  .sources {
    margin: var(--space-7) 0;
    padding: var(--space-5);
    background: #f9fafb;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
  }

  .sources h3 {
    font-size: var(--title-subsection-size);
    margin-bottom: 1rem;
    color: #1f2937;
    font-weight: 800;
    font-family: var(--font-editorial);
    line-height: var(--title-line-height);
    letter-spacing: var(--title-letter-spacing);
  }

  .sources ul {
    list-style: none;
    padding: 0;
  }

  .sources li {
    margin-bottom: 0.5rem;
  }

  .sources a {
    color: var(--categoryColor);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .sources a:hover {
    text-decoration: underline;
  }

  /* Article Footer */
  .article-footer {
    margin: var(--space-7) 0;
    padding: var(--space-5) 0;
    border-top: 2px solid #f1f5f9;
  }

  .tags-section {
    margin-bottom: 2rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-chip);
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid rgba(148, 163, 184, 0.14);
  }

  .share-section {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .share-label {
    color: #6b7280;
    font-weight: 500;
  }

  .share-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .share-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: #f3f4f6;
    color: #374151;
    text-decoration: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .share-btn:hover {
    background: #e5e7eb;
    transform: translateY(-1px);
  }

  .share-btn.twitter:hover {
    background: #1da1f2;
    color: white;
  }

  .share-btn.facebook:hover {
    background: #1877f2;
    color: white;
  }

  /* Related Articles */
  .related-articles {
    margin: var(--space-8) 0 var(--space-7);
    padding: var(--space-7) 0 var(--space-5);
    border-top: 1px solid #e0e0e0;
  }

  .related-title {
    font-family: var(--font-editorial);
    font-size: var(--title-subsection-size);
    font-weight: 800;
    color: #1a1a1a;
    margin-bottom: 1.75rem;
    letter-spacing: var(--title-letter-spacing);
    line-height: var(--title-line-height);
  }

  .related-grid {
    display: grid;
    gap: 1rem;
  }

  .related-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid;
    border-radius: 22px;
    text-decoration: none;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease,
      background 0.22s ease;
    box-shadow: var(--shadow-soft);
  }

  .related-card:hover {
    background: white;
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .related-card-content {
    flex: 1;
  }

  .related-card-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .related-card-desc {
    font-size: 0.875rem;
    color: #6b7280;
    line-height: 1.4;
    margin: 0;
  }

  .related-card-arrow {
    font-size: 1.125rem;
    font-weight: 600;
    margin-left: 1rem;
    transition: transform 0.2s ease;
  }

  .related-card:hover .related-card-arrow {
    transform: translateX(3px);
  }

  /* Random Explore */
  .random-explore {
    text-align: center;
    margin: 2rem 0;
  }

  .random-btn {
    background: transparent;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.75rem 1.75rem;
    font-size: 1rem;
    font-weight: 500;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .random-btn:hover {
    background: #f8fafc;
    border-color: #94a3b8;
    color: #1e293b;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  /* More Articles */
  .more-articles {
    margin: var(--space-8) 0;
    padding: var(--space-7) 0;
    border-top: 2px solid #f1f5f9;
  }

  .more-title {
    text-align: center;
    font-size: var(--title-subsection-size);
    font-weight: 800;
    color: #1f2937;
    margin-bottom: 2rem;
    font-family: var(--font-editorial);
    line-height: var(--title-line-height);
    letter-spacing: var(--title-letter-spacing);
  }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .more-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid;
    border-radius: 22px;
    text-decoration: none;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
    box-shadow: var(--shadow-soft);
  }

  .more-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .more-card-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .more-card-content {
    flex: 1;
  }

  .more-card-name {
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .more-card-desc {
    color: #6b7280;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  /* Article Footer Actions */
  .article-footer-actions {
    margin: var(--space-8) 0 var(--space-5) 0;
    border-top: 2px solid #f1f5f9;
    padding-top: var(--space-7);
  }

  .section-divider {
