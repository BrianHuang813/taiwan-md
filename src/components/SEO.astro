---
interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  lang?: 'zh-TW' | 'en' | 'es';
  type?: 'website' | 'article';
  datePublished?: string;
  dateModified?: string;
  content?: string;
  tags?: string[];
  category?: string;
}

const {
  title,
  description = '讓全世界完整認識台灣 - 開源台灣知識庫，蒐集關於台灣的政治、經濟、文化、歷史、地理等各方面知識。',
  image = '/images/taiwan-social.jpg',
  url = Astro.url.href,
  lang = 'zh-TW',
  type = 'website',
  datePublished,
  dateModified,
  content,
  tags,
  category
} = Astro.props;

const fullTitle = `${title} | Taiwan.md`;
const siteUrl = 'https://taiwan.md';
const fullImageUrl = new URL(image, siteUrl).href;

// Generate AI-friendly summary from description or content
const aiSummary = description || (content ? content.substring(0, 300).replace(/[\n\r]/g, ' ').replace(/[#*]/g, '').trim() + '...' : '');

// Organization JSON-LD (on every page)
const organizationLD = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Taiwan.md",
  "url": siteUrl,
  "logo": `${siteUrl}/favicon.png`,
  "description": "Open-source, community-curated knowledge repository about Taiwan",
  "sameAs": [
    "https://github.com/frank890417/taiwan-md",
    "https://x.com/taiwandotmd",
    "https://www.instagram.com/taiwandotmd"
  ]
};

// Generate page-specific JSON-LD
const generatePageLD = () => {
  if (type === 'article' && datePublished) {
    return {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "author": {
        "@type": "Organization",
        "name": "Taiwan.md"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Taiwan.md",
        "url": siteUrl,
        "logo": {
          "@type": "ImageObject",
          "url": `${siteUrl}/favicon.png`
        }
      },
      "datePublished": datePublished,
      "dateModified": dateModified || datePublished,
      "inLanguage": lang,
      "url": url,
      "image": fullImageUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": url }
    };
  }
  return {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Taiwan.md - 台灣知識庫",
    "description": "讓全世界完整認識台灣 - 開源台灣知識庫",
    "url": siteUrl,
    "inLanguage": lang,
    "publisher": { "@type": "Organization", "name": "Taiwan.md", "url": siteUrl }
  };
};

const pageLD = generatePageLD();

// BreadcrumbList JSON-LD
const breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Taiwan.md", "item": siteUrl }
];
if (category) {
  const catPath = lang === 'zh-TW' ? `/${category}` : `/${lang}/${category}`;
  breadcrumbItems.push({ "@type": "ListItem", "position": 2, "name": category, "item": `${siteUrl}${catPath}` });
}
if (type === 'article') {
  breadcrumbItems.push({ "@type": "ListItem", "position": breadcrumbItems.length + 1, "name": title });
}
const breadcrumbLD = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};

// Dynamic keywords
const baseKeywords = '台灣, Taiwan, Taiwán, 台灣知識庫, Taiwan knowledge base';
const dynamicKeywords = [baseKeywords, ...(category ? [category] : []), ...(tags || [])].join(', ');

// Locale map
const localeMap: Record<string, string> = { 'zh-TW': 'zh_TW', 'en': 'en_US', 'es': 'es_419' };
---

<!-- Basic Meta Tags -->
<meta name="description" content={description} />
<meta name="keywords" content={dynamicKeywords} />
<meta name="author" content="Taiwan.md" />
<meta name="generator" content="Taiwan.md" />

<!-- AI-friendly summary meta tag -->
<meta name="ai-summary" content={aiSummary} />

<!-- Canonical URL -->
<link rel="canonical" href={url} />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title="Taiwan.md RSS Feed" href={`${siteUrl}/feed.xml`} />

<!-- Language Tags -->
<link rel="alternate" hreflang="zh-TW" href={siteUrl} />
<link rel="alternate" hreflang="en" href={`${siteUrl}/en`} />
<link rel="alternate" hreflang="es" href={`${siteUrl}/es`} />
<link rel="alternate" hreflang="x-default" href={siteUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:alt" content={`${title} - Taiwan.md`} />
<meta property="og:site_name" content="Taiwan.md" />
<meta property="og:locale" content={localeMap[lang] || 'en_US'} />
{datePublished && <meta property="article:published_time" content={datePublished} />}
{dateModified && <meta property="article:modified_time" content={dateModified} />}
{tags && tags.map((tag: string) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={url} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={`${title} - Taiwan.md`} />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(organizationLD)} />
<script type="application/ld+json" set:html={JSON.stringify(pageLD)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />